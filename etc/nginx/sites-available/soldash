server {
    server_name soldash.space www.soldash.space;


location /websocket {
    proxy_pass http://173.231.11.114:8080/websocket;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 86400;
}

location /assets/ {
    proxy_pass http://173.231.11.114:8080/assets/;
    proxy_set_header Host $host;
}

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/soldash.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/soldash.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
	
    add_header 'Access-Control-Allow-Origin' 'https://fd.soldash.space';

}
server {
    if ($host = www.soldash.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = soldash.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name soldash.space www.soldash.space;
    return 404; # managed by Certbot




}
