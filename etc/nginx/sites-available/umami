server {
    server_name analytics.soldash.space;

    location /_next/static/ {
        alias /home/soldapp/umami/.next/static/;
        expires 1y;
        access_log off;
    }

    location /script.js {
        alias /home/soldapp/umami/public/script.js;
        access_log off;
    }

    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;


    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/analytics.soldash.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/analytics.soldash.space/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = analytics.soldash.space) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name analytics.soldash.space;
    return 404;
}
